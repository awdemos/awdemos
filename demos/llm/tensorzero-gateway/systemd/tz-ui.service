[Unit]
Description=TensorZero UI (:8181, loopback only)
After=tz-gateway.service
Requires=tz-gateway.service

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/tensorzero/bin/tz-ui-run.sh
ExecStop=podman --root %h/tensorzero/podman-storage stop -t 10 tz-ui
Restart=always
RestartSec=15
TimeoutStartSec=300

[Install]
WantedBy=default.target
